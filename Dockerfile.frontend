# ============================================================
# PureCore Frontend Dockerfile
# Multi-stage build: Bun SSR server for production
# ============================================================

# Stage 1: Build the frontend assets
FROM oven/bun:1.3-alpine AS builder

WORKDIR /app

# Build-time arguments for API connectivity
# These are injected from docker-compose or --build-arg
ARG VITE_API_PROTOCOL=http
# VITE_API_HOST and VITE_API_PORT intentionally left empty for client builds.
# The browser cannot resolve Docker service names (like "backend").
# Client-side JS will fall back to relative /api/v1 URLs, which are proxied
# by the SSR server to the backend using the runtime environment variables.
ARG VITE_API_HOST=
ARG VITE_API_PORT=
ARG VITE_ADMIN_ROUTE_PREFIX=control-panel
ENV VITE_API_PROTOCOL=$VITE_API_PROTOCOL
ENV VITE_API_HOST=$VITE_API_HOST
ENV VITE_API_PORT=$VITE_API_PORT
ENV VITE_ADMIN_ROUTE_PREFIX=$VITE_ADMIN_ROUTE_PREFIX

# Copy dependency files first for layer caching
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile

# Copy frontend source (includes web/public/ directory tree)
COPY web/ ./

# web/public/lang may be a symlink → ../../lang (not resolved in container).
# Copy the actual shared language files into public/lang to satisfy Vite 8 prepareOutDir.
COPY lang/ /tmp/lang/
RUN rm -rf public/lang && mkdir -p public/lang && cp /tmp/lang/*.json public/lang/ && rm -rf /tmp/lang

# Build client + server bundles
RUN bun run build

# Stage 2: Minimal production runtime
FROM oven/bun:1.3-alpine

RUN apk add --no-cache tzdata curl

WORKDIR /app

# Copy built assets from builder
COPY --from=builder /app/dist ./dist
# Copy SSR server and package.json (for purecore project info)
COPY --from=builder /app/server.js .
COPY --from=builder /app/package.json .
# Copy theme config for SSR (theme.config.json provides the default theme)
COPY --from=builder /app/theme.config.json .
# Copy language files for SSR translations (expected at web/public/lang/)
COPY --from=builder /app/public/lang ./public/lang
# Vite 8 SSR runtime: the built entry-server.js requires vite/module-runner and
# its transitive dependencies (rolldown + native bindings). Copy all node_modules.
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 9001

ENV NODE_ENV=production
ENV SSR_PORT=9001

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD curl -sf http://localhost:9001/ || exit 1

CMD ["bun", "run", "server.js"]
