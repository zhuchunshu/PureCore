# ============================================================
# PureCore Frontend Dockerfile
# Multi-stage build: Bun SSR server for production
# ============================================================

# Stage 1: Build the frontend assets
FROM oven/bun:1.3-alpine AS builder

WORKDIR /app

# Copy dependency files first for layer caching
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile

# Copy frontend source
COPY web/ ./

# Build client + server bundles
RUN bun run build

# Stage 2: Minimal production runtime
FROM oven/bun:1.3-alpine

RUN apk add --no-cache tzdata

WORKDIR /app

# Copy built assets from builder
COPY --from=builder /app/dist ./dist
# Copy SSR server and package.json (for purecore project info)
COPY --from=builder /app/server.js .
COPY --from=builder /app/package.json .
# Copy language files for SSR translations
COPY --from=builder /app/public/lang ./public/lang

EXPOSE 9001

ENV NODE_ENV=production
ENV SSR_PORT=9001

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:9001/ || exit 1

CMD ["bun", "run", "server.js"]
