# PureCore 配置 / PureCore Configuration
# 前端 / Frontend
FRONTEND_PORT=9001

# Vite 开发服务器允许的主机名 (逗号分隔)
# 用于内网穿透/反向代理场景，防止被 Vite 拦截
# 示例: VITE_ALLOWED_HOSTS=dev-purecore.typecho.ltd,.typecho.ltd,my-app.local
VITE_ALLOWED_HOSTS=

# 后端 / Backend
BACKEND_PORT=9002

# CORS 跨域允许的来源 (逗号分隔)
# 留空或设为 * 表示允许所有来源
# 指定具体域名时自动启用 AllowCredentials
# 示例: CORS_ALLOW_ORIGINS=https://dev-purecore.typecho.ltd,https://example.com
CORS_ALLOW_ORIGINS=*

# API 协议和主机 (前端连接后端使用)
# 可用值: http 或 https
VITE_API_PROTOCOL=http
# 可用值: localhost, 127.0.0.1, 你的域名等
# 使用反向代理时，前端 API 请求应走相对路径 /api/v1，由 SSR/Vite 代理转发到后端
# 因此清空 VITE_API_HOST 即可 —— client 端会用 /api/v1，server 端默认 fallback 到 localhost
# 如果前后端分离部署且无代理层，再恢复 VITE_API_HOST=你的后端域名
VITE_API_HOST=localhost
# 如果 VITE_API_HOST 设置，则 VITE_API_BASE_URL 自动生成为 {VITE_API_PROTOCOL}://{VITE_API_HOST}:{VITE_API_PORT}
# 你也可以直接设置 VITE_API_BASE_URL 覆盖自动生成的 URL
# VITE_API_BASE_URL=http://localhost:9002
VITE_API_PORT=9002

# 数据库 / Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=purecore
DB_SSLMODE=disable

# 应用 / App
APP_ENV=local
APP_DEBUG=true

# 主题 / Theme
# DaisyUI 主题名称，可用值: light, dark, cupcake, bumblebee, emerald, corporate, synthwave, retro, cyberpunk, valentine, halloween, garden, forest, aqua, lofi, pastel, fantasy, wireframe, black, luxury, dracula, cmyk, autumn, business, acid, lemonade, night, coffee, winter, dim, nord, sunset
# 修改此值即可全局切换主题，无需修改代码
# 优先级: 用户手动选择 > 环境变量 THEME / VITE_THEME > theme.config.json > 'sunset'
THEME=sunset
VITE_THEME=sunset

# 管理员 / Admin
ADMIN_ROUTE_PREFIX=control-panel
VITE_ADMIN_ROUTE_PREFIX=control-panel
JWT_SECRET=your-jwt-secret-here
